# Local backend (`go run .` from backend/). Copy to backend/.env
# Full reference: docs/deployment/configuration.md

# HTTP listen port. Default: 8080
APP_PORT=8080

# Where the app database, logs, and secrets are stored.
# local | docker | testing
APP_ENV=local

# Which client this server is for. desktop never shows a login screen.
# desktop | web
APP_CLIENT=web

# Public origin for MCP and API URLs. No trailing slash.
# Default: http://127.0.0.1:<APP_PORT>
# APP_PUBLIC_URL=http://localhost:8080

# MCP endpoint URL.
# Default: <APP_PUBLIC_URL>/api/mcp
# APP_MCP_PUBLIC_URL=http://localhost:8080/api/mcp

# Web login. Ignored when APP_CLIENT=desktop.
# none  — no login screen
# local — email and password login
APP_AUTH_MODE=none

# First admin. Used only when APP_AUTH_MODE=local and no user exists yet.
# Password: 8–40 characters, with a letter and a number. Change it on first sign-in.
# APP_ADMIN_EMAIL=admin@example.com
# APP_ADMIN_PASSWORD=ChangeMe1

# Browser origins allowed to send credentialed requests. Comma-separated.
# Required when APP_AUTH_MODE=local. With none, localhost is allowed automatically.
APP_ALLOWED_ORIGINS=http://localhost:3000

# App metadata SQLite file. Default depends on APP_ENV.
# APP_DATABASE_PATH=data/dbo.db

# Log directory. Default depends on APP_ENV.
# APP_LOG_PATH=data/logs

# AES key file for saved connection secrets. Default depends on APP_ENV.
# APP_SECRET_KEY_PATH=data/app_secret.key

# Override the website API base URL (updates, releases). No trailing slash.
# APP_WEBSITE_API_URL=

# known_hosts file used to verify SSH tunnel host keys.
# SSH_KNOWN_HOSTS_PATH=~/.ssh/known_hosts

# Enable the NoSQL fixture (e2e/dev only). Set to 1 to turn on.
DBO_ENABLE_NOSQL_FIXTURE=0

# Cloud backup destination OAuth clients. <PROVIDER> = GOOGLE | DROPBOX | ONEDRIVE.
# DBO_OAUTH_GOOGLE_CLIENT_ID=
# DBO_OAUTH_GOOGLE_CLIENT_SECRET=

# DBO_OAUTH_DROPBOX_CLIENT_ID=
# DBO_OAUTH_DROPBOX_CLIENT_SECRET=

# DBO_OAUTH_ONEDRIVE_CLIENT_ID=
# DBO_OAUTH_ONEDRIVE_CLIENT_SECRET=

# Local backend development (`go run .` from backend/)
# Copy to backend/.env
# Full reference: docs/deployment/configuration.md

APP_PORT=8080
APP_ENV=local
APP_CLIENT=web

# Public origin when testing MCP or API URLs outside localhost.
# APP_PUBLIC_URL=http://localhost:8080
# APP_MCP_PUBLIC_URL=http://localhost:8080/api/mcp

# Server-mode authentication: when set, API access requires a session created
# by POST /api/config/auth with this token (used for web deployments on a real
# server). Must be at least 32 characters. Leave unset for local dev and desktop.
# APP_AUTH_TOKEN=

# Extra origins (comma-separated) allowed to make credentialed cross-origin
# requests. localhost/127.0.0.1 are allowed only when APP_AUTH_TOKEN is unset.
# APP_ALLOWED_ORIGINS=https://dbo.example.com

# Storage overrides (defaults resolve per APP_ENV — see configuration.md).
# APP_DATABASE_PATH=data/dbo.db
# APP_LOG_PATH=data/logs
# APP_SECRET_KEY_PATH=data/app_secret.key

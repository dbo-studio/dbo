# Local backend development (`go run .` from backend/)
# Copy to backend/.env
# Full reference: docs/deployment/configuration.md

APP_PORT=8080
APP_ENV=local
APP_CLIENT=web

# Public origin when testing MCP or API URLs outside localhost.
# APP_PUBLIC_URL=http://localhost:8080
# APP_MCP_PUBLIC_URL=http://localhost:8080/api/mcp

# Login (web only; desktop ignores it).
#   none  — no login screen (default).
#   local — email/password login. With no user yet, the server prints a one-time
#           setup link in its log to create the admin, or set APP_ADMIN_* below
#           to seed it instead.
# Switch back to none and restart to turn login off: users are kept, and every
# browser acts as the first admin. Do not do that on a host others can reach.
# APP_AUTH_MODE=local

# Optional first admin when APP_AUTH_MODE=local and no user exists. Must change
# the password on first sign-in. 8–40 characters, a letter and a number.
# APP_ADMIN_EMAIL=admin@example.com
# APP_ADMIN_PASSWORD=ChangeMe1

# Extra origins (comma-separated) for credentialed CORS. Required when mode is
# local. localhost is auto-trusted only in mode "none".
APP_ALLOWED_ORIGINS=http://localhost:3000

# Storage overrides (defaults resolve per APP_ENV — see configuration.md).
# APP_DATABASE_PATH=data/dbo.db
# APP_LOG_PATH=data/logs
# APP_SECRET_KEY_PATH=data/app_secret.key

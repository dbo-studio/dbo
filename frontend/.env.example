# Local frontend development
# Copy to frontend/.env
# Full reference: docs/deployment/configuration.md

# Backend API base URL (dev server proxies /api when unset in vite.config)
VITE_PUBLIC_SERVER_URL=http://localhost:8080/api

# Vite dev server port
VITE_PORT=3000

# Tauri desktop builds set TAURI_ENV_* automatically — do not configure here.

{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": "npm --prefix frontend run build",
    "beforeDevCommand": "npm --prefix frontend run dev",
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:3001"
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "copyright": "",
    "publisher": "DBO Studio",
    "targets": [
      "deb",
      "nsis",
      "dmg",
      "appimage"
    ],
    "externalBin": [
      "bin/dbo-bin"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp"
      }
    },
    "longDescription": "",
    "macOS": {
      "entitlements": "entitlements.plist",
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null
    },
    "resources": [],
    "shortDescription": "Modern and easy to use SQL client",
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "createUpdaterArtifacts": true
  },
  "productName": "DBO",
  "mainBinaryName": "DBO",
  "version": "1.0.1",
  "identifier": "com.dbostudio.dev",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU2NzZEOTdDMkU4RTVFOTIKUldTU1hvNHVmTmwyNW9mbE9CK0liUlNKZmIxbnhhRlVIYm81QlZwUG9xUXA0MEZ0VW4vdjZiWW0K",
      "endpoints": [
        "https://github.com/dbo-studio/dbo/releases/latest/download/latest.json"
      ]
    }
  },
  "app": {
    "windows": [
      {
        "height": 800,
        "resizable": true,
        "title": "DBO",
        "width": 1280,
        "center": true,
        "minWidth": 1280,
        "minHeight": 700,
        "decorations": true,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost http://127.0.0.1:* http://localhost:*; worker-src 'self' blob:"
    }
  }
}